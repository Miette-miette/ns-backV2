{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}Liste Atelier{% endblock %}

{% block content %}
    <main class="pages d-flex flex-column">

        <div class="container align-items-center w-100 w-md-75 p-2">
            <a href="{{ app.request.headers.get('referer') ?: 'https://nsfestival2024.online' }}" class="link-orange h5">
                ← Revenir à la page précédente
            </a>
        </div>

        <section class="d-flex flex-column">
            <h1>Bienvenue au sein de l'administration de Nation-Sounds</h1>
            <p>Tout les outils pour piloter le site de Nation-Sounds en toute simplicité!<p>
        </section>

        <div class="d-flex flex-wrap container">

            <section id="mailer" class="d-flex flex-row m-4">
                <img src="/media/icons/megaphone.png" width="100px" height="100px">
                <div class="d-flex flex-column">
                    <h2>Demande de contact</h2>
                    <a href="https://mailtrap.io/inboxes">Acceder à la boite mail</a>
                </div>
            </section>

            <section class="d-flex flex-row m-4">
                <img src="/media/icons/ns_mascotte.png" width="100px" height="90px">
                <div class="d-flex flex-column">
                    <h2>Acceder au site</h2>
                    <a href="https://nsfestival2024.online">Nation-Sounds Festival</a>
                </div>
            </section>
        </div>

    </main>

{% endblock %}